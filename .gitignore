# Build and packaging output. Everything here is reproducible from source
# with build.bat / package.bat.
/build/
/dist/

# Superseded builds kept locally for rollback and comparison. Binaries, and
# not part of the current source tree - see archive/*/README.txt.
/archive/
*.o
*.obj
*.res

# Settings and data Dental Macros writes next to its own executable at runtime.
# These belong to whoever is running it, not to the repository.
macros.json
macros.json.bak
macros.json.bak.*
/backups/
/layouts/
/images/

# Editor and OS leftovers
*.user
*.suo
.vs/
Thumbs.db
desktop.ini
.DS_Store
