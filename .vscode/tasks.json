{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Dental Macros",
      "type": "shell",
      "command": "${workspaceFolder}/build.bat",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/run_tests.bat",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
